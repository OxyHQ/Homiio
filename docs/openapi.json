{
  "openapi": "3.1.0",
  "info": {
    "title": "Homiio public API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://api.homiio.com/api/v1"
    }
  ],
  "paths": {
    "/cases/batch": {
      "post": {
        "operationId": "getPublicCases",
        "description": "Resolve 1–50 case references. Duplicate IDs are collapsed. Missing, archived and held cases are unavailable. Responses are not cacheable.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicCaseBatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current public cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicCaseBatchResponse"
                }
              }
            }
          },
          "400": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/team-chat/operations/read": {
      "post": {
        "operationId": "readTeamOperation",
        "security": [
          {
            "TeamOperationCapability": []
          }
        ],
        "description": "Read one immutable operation using its header-only capability; no message or housing content.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeamOperationIdRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current public cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamOperation"
                }
              }
            }
          },
          "400": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/evictions/{id}/team-chat/operations": {
      "post": {
        "operationId": "beginTeamOperation",
        "servers": [
          {
            "url": "https://api.homiio.com/api"
          }
        ],
        "security": [
          {
            "OxySession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Creator-only durable operation. Add requires acknowledging access to the exact address. Retries resume the pending operation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BeginTeamOperation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current public cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivateTeamOperation"
                }
              }
            }
          },
          "400": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/team-chat/finalize": {
      "post": {
        "operationId": "finalizeTeamOperation",
        "servers": [
          {
            "url": "https://api.homiio.com/api"
          }
        ],
        "security": [
          {
            "OxySession": []
          }
        ],
        "description": "Creator-only finalization after Allo confirms the frozen exact account set. Replays return the finalized operation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeamOperationIdRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current public cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamOperation"
                }
              }
            }
          },
          "400": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OxySession": {
        "type": "http",
        "scheme": "bearer"
      },
      "TeamOperationCapability": {
        "type": "apiKey",
        "in": "header",
        "name": "x-homiio-team-operation"
      }
    },
    "schemas": {
      "PublicCaseBatchRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ids": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [
          "ids"
        ],
        "additionalProperties": false
      },
      "PublicCaseBatchResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "area": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "precision": {
                      "type": "string",
                      "const": "area"
                    }
                  },
                  "required": [
                    "label",
                    "precision"
                  ],
                  "additionalProperties": false
                },
                "scheduledAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "upcoming",
                    "stopped",
                    "postponed",
                    "executed",
                    "cancelled"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "id",
                "title",
                "area",
                "scheduledAt",
                "status",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "unavailableIds": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [
          "items",
          "unavailableIds"
        ],
        "additionalProperties": false
      },
      "ApiError": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "bad_request",
                  "unauthorized",
                  "forbidden",
                  "not_found",
                  "unknown_route",
                  "gone",
                  "conflict",
                  "validation_failed",
                  "rate_limited",
                  "internal_error",
                  "service_unavailable"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "BeginTeamOperation": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "open",
              "add",
              "remove"
            ]
          },
          "oxyUserId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "acknowledgeExactLocationAccess": {
            "type": "boolean"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "PrivateTeamOperation": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operation": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "caseId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "ownerAccountId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "action": {
                "type": "string",
                "enum": [
                  "open",
                  "add",
                  "remove"
                ]
              },
              "targetAccountIds": {
                "minItems": 1,
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "teamReferenceHash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "finalized": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "caseId",
              "ownerAccountId",
              "action",
              "targetAccountIds",
              "teamReferenceHash",
              "finalized"
            ],
            "additionalProperties": false
          },
          "capability": {
            "type": "string"
          },
          "teamReference": {
            "type": "string"
          }
        },
        "required": [
          "operation",
          "capability",
          "teamReference"
        ],
        "additionalProperties": false
      },
      "TeamOperation": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "caseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "ownerAccountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "action": {
            "type": "string",
            "enum": [
              "open",
              "add",
              "remove"
            ]
          },
          "targetAccountIds": {
            "minItems": 1,
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "teamReferenceHash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "finalized": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "caseId",
          "ownerAccountId",
          "action",
          "targetAccountIds",
          "teamReferenceHash",
          "finalized"
        ],
        "additionalProperties": false
      },
      "TeamOperationIdRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "operationId"
        ],
        "additionalProperties": false
      }
    }
  }
}
