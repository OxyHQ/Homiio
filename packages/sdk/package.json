{
  "name": "@oxy.so/homiio-sdk",
  "version": "0.1.2",
  "description": "Homiio public case sdk",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test tests",
    "prepack": "bun run build",
    "prepublishOnly": "bun run build && bun run test"
  },
  "dependencies": {
    "@oxy.so/homiio-contracts": "0.1.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
