{
  "name": "@oxy.so/homiio-sdk",
  "version": "0.2.0",
  "description": "Homiio public case sdk",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/Homiio.git",
    "directory": "packages/sdk"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "bun test tests"
  },
  "dependencies": {
    "@oxy.so/homiio-contracts": "0.2.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
