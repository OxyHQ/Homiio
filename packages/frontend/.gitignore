# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
# Anchored with a leading slash on purpose: an unanchored `android/` matches at
# EVERY depth, which silently swallows the source of local Expo modules under
# `modules/*/android/`. That source is checked in — it is the widget, not build
# output — while `/android` and `/ios` at the app root stay ignored because CNG
# regenerates them at every prebuild.
/android/
/ios/

# Gradle output from the local Expo modules, whose source above is tracked.
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example
