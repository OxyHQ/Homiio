{
  "name": "homiio-monorepo",
  "version": "2.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Homiio Monorepo - Frontend and Backend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run dev --filter '*'",
    "dev:frontend": "bun run --filter @homiio/frontend dev",
    "dev:backend": "bun run --filter @homiio/backend dev",
    "build": "bun run --filter '*' build",
    "build:shared-types": "bun run --filter @homiio/shared-types build",
    "build:frontend": "bun run --filter @homiio/frontend build",
    "build:backend": "bun run --filter @homiio/backend build",
    "test": "bun run --filter '*' test",
    "lint": "biome check . && bun run --cwd packages/frontend lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "doctor:oxy": "oxy-doctor --ci",
    "check:bundle-imports": "bun ./scripts/check-frontend-bundle-imports.mjs && bun ./scripts/test-check-frontend-bundle-imports.mjs",
    "check:web-bundle-budget": "bun ./scripts/check-web-export-budget.mjs",
    "check:lockfile": "bun ./scripts/check-lockfile-sync.mjs",
    "validate:agents-md": "bun ./scripts/check-agents-md-size.mjs && bun ./scripts/test-check-agents-md-size.mjs",
    "check:docs": "bun ./scripts/check-docs.mjs",
    "clean": "bun run --filter '*' clean && rm -rf node_modules",
    "install:all": "bun install",
    "start:frontend": "bun run --filter @homiio/frontend start",
    "start:backend": "bun run --filter @homiio/backend start",
    "postinstall": "bun run --filter @oxy.so/homiio-contracts build && bun run build:shared-types",
    "check:openapi": "bun scripts/generate-openapi.ts --check",
    "generate:openapi": "bun scripts/generate-openapi.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@oxy.so/doctor": "1.1.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@oxy.so/core": "5.4.0",
    "@oxy.so/bloom": "12.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "expo-modules-core": "58.0.22",
    "react-native-svg": "15.16.0",
    "@oxy.so/contracts": "4.24.0",
    "@oxy.so/protocol": "1.4.0",
    "@oxy.so/services": "11.14.0",
    "@oxy.so/mcp": "1.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "@types/express": "^4.17.25",
    "react-native-css": "3.1.0-rc.0",
    "@oxy.so/allo-contracts": "0.1.0"
  },
  "resolutions": {
    "@oxy.so/core": "5.4.0",
    "react-native-css": "3.1.0-rc.0"
  },
  "cacheDirectories": [],
  "dependencies": {
    "@oxy.so/core": "5.4.0",
    "@oxy.so/bloom": "12.4.0",
    "zod": "3.25.76"
  }
}
